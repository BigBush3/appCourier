{
  "expo": {
    "name": "FloraPoint курьер",
    "slug": "ibmCurProject",
    "privacy": "public",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "ru.ibmcurr",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Это приложение будет дополнительно использовать Face ID или Touch ID, чтобы сохранить логин",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "ru.ibmcurr",
      "versionCode": 18,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBoUapnKr9gZzCZcuQo4S0HUOHdNfqO5LA"
        }
      },
      "googleServicesFile": "./google-services.json"
    },
    "version": "9.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "ndkVersion": "27.1.12297006"
          }
        }
      ],
      "./plugins/withAndroidSigning"
    ],
    "extra": {
      "eas": {
        "projectId": "a627ee48-2e80-41b5-9b68-ae0bfc6c2aad"
      }
    }
  }
}
